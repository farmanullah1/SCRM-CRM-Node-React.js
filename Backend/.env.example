PORT=5000
NODE_ENV=development

# SQL Server Configuration (Sequelize)
DB_NAME=SCRM
DB_USER=sa
DB_PASSWORD=your_password_here
DB_SERVER=localhost
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Session cookies are HttpOnly and Secure in production. SameSite=Lax works
# for same-origin/same-site deployments; use None only with HTTPS cross-site.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Online invoice payments (Stripe hosted Checkout).
# Card data never reaches this server; only the Stripe session ID is stored.
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_webhook_endpoint
PAYMENT_CURRENCY=usd
# Public frontend origin used for success/cancel redirects.
PAYMENT_APP_URL=http://localhost:5173
# Optional overrides; {CHECKOUT_SESSION_ID} is substituted by Stripe.
# PAYMENT_CHECKOUT_SUCCESS_URL=http://localhost:5173/app/invoices?payment=success&session_id={CHECKOUT_SESSION_ID}
# PAYMENT_CHECKOUT_CANCEL_URL=http://localhost:5173/app/invoices?payment=cancelled

# Stripe webhook endpoint to create in the dashboard:
# https://<backend-host>/api/payments/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired
