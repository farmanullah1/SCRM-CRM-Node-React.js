# Copy to .env beside docker-compose.yml. Never commit the real values.
MSSQL_SA_PASSWORD=replace-with-a-long-random-password
DB_NAME=SCRM
JWT_SECRET=replace-with-at-least-32-random-bytes

# Public URLs used in email links and Google OAuth callbacks.
APP_URL=https://crm.example.com
BACKEND_URL=https://crm.example.com
HTTP_PORT=8080

# Mail: use either Gmail app-password credentials or generic SMTP.
GMAIL_USER=
GMAIL_APP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCRM" <no-reply@example.com>

# Google OAuth web client ID (authorize https://crm.example.com).
GOOGLE_CLIENT_ID=

# ImageKit media uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-endpoint-id

# Optional Slack incoming webhook.
SLACK_WEBHOOK_URL=
